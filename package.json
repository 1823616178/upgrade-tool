{
  "name": "ai-code-tool-updater",
  "version": "1.0.0",
  "description": "AI 编程助手工具更新器 - 检测版本并一键更新",
  "main": "main.js",
  "scripts": {
    "start": "electron . --disable-gpu-shader-disk-cache",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "sign:win": "powershell -ExecutionPolicy Bypass -File scripts/sign-and-build.ps1",
    "build:mac": "electron-builder --mac",
    "icons": "node scripts/generate-icons.js",
    "test": "node scripts/verify-semver.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "updater",
    "kimi",
    "claude",
    "codex",
    "opencode",
    "codebuddy"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@fiahfy/icns": "^0.0.7",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.aicode.tool-updater",
    "productName": "AI Code Tool Updater",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "script.js",
      "package.json",
      "build/icon.ico",
      "build/icon.icns",
      "build/icon.png"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "cscLink": "build/certificate.pfx",
      "cscKeyPassword": "123456",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "publisherName": "AI Code Tool Updater",
        "signingHashAlgorithms": ["sha256"]
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Code Tool Updater"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
